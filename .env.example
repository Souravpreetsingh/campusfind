# CampusFind environment variables
#
# Copy this file to .env and replace every placeholder before starting the app.
# `npm run check:env` validates these values and refuses known placeholders.
# Never commit .env. Values shown here are examples only and are NOT secrets.

# PostgreSQL connection string used by Prisma.
# Example: postgresql://user:password@localhost:5432/campusfind?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusfind?schema=public"

# Secret used to sign session JWTs. MUST be at least 32 characters long (characters, not bytes).
# Generate a fresh value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WARNING: never use a placeholder, default, or value copied from a repository or chat.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public origin used for links, cookies and generated sitemap entries.
# The app listens on port 3001 by default (npm run dev / npm start).
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Bootstrap administrator created/used by `npm run db:seed`.
# WARNING: change both values before any non-local deployment.
SEED_ADMIN_EMAIL="admin@campusfind.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Optional: local directory for uploaded evidence files. Defaults to .data/uploads.
# Must be writable by the application process and persisted between deploys.
UPLOAD_DIR=".data/uploads"

# Optional: seed fictional demo reports/claims. Defaults to false.
SEED_DEMO_DATA=false

# Optional: rotate the seeded admin password on every seed run. Defaults to false.
# Enable only when intentionally rotating credentials.
SEED_ADMIN_ROTATE=false
